[Unit]
Wants=image-bootstrap@%N.service image-build@%N.timer ollama.service
Wants=image-bootstrap@litellm.service image-build@litellm.timer
After=image-bootstrap@%N.service image-bootstrap@litellm.service ollama.service

[Kube]
Yaml=/etc/containers/systemd/docs.yml
Network=docs.network
Network=ollama.network

[Service]
Restart=on-failure
Slice=prod-tier0.slice

[Install]
WantedBy=prod.target
