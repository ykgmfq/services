[Unit]
Wants=image-bootstrap@%N.service image-build@%N.timer office.service
After=image-bootstrap@%N.service office.service

[Kube]
Yaml=/etc/containers/systemd/cloud.yml
Network=cloud.network
Network=ollama.network
Network=office.network

[Service]
Restart=on-failure
Slice=prod-tier0.slice

[Install]
WantedBy=prod.target
